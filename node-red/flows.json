    {
        "id": "mqtt-in-status",
        "type": "mqtt in",
        "z": "fiber-dashboard-tab",
        "name": "Device Status",
        "topic": "fiber/+/status",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker-1",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 120,
        "wires": [
            [
                "func-parse-status"
            ]
        ]
    },
    {
        "id": "func-parse-status",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Parse Status",
        "func": "var parts = msg.topic.split('/');\nvar hostname = parts[1];\nvar online = msg.payload.status === 'online';\nflow.set('device_hostname', hostname);\nflow.set('device_online', online);\n\nmsg.payload = (online ? 'ONLINE' : 'OFFLINE') + ' — ' + hostname;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "x": 330,
        "y": 120,
        "wires": [
            [
                "ui-txt-status"
            ]
        ]
    },
    {
        "id": "ui-txt-status",
        "type": "ui-text",
        "z": "fiber-dashboard-tab",
        "group": "group-device",
        "order": 1,
        "width": "6",
        "height": "1",
        "name": "Status",
        "label": "Status",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "style": false,
        "font": "",
        "color": "",
        "x": 490,
        "y": 120,
        "wires": []
    },
    {
        "id": "mqtt-in-sysinfo",
        "type": "mqtt in",
        "z": "fiber-dashboard-tab",
        "name": "System Info",
        "topic": "fiber/+/system/info",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker-1",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 280,
        "wires": [
            [
                "func-parse-sysinfo"
            ]
        ]
    },
    {
        "id": "func-parse-sysinfo",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Parse System Info",
        "func": "var info = msg.payload;\nflow.set('latest_sysinfo', info);\n\nvar power = info.power || {};\nvar bat = power.battery || {};\nvar dc = power.dc || {};\nvar net = info.network || {};\nvar wifi = net.wifi || {};\nvar eth = net.ethernet || {};\nvar stor = (info.storage || {}).data_partition || {};\n\n// Output 1: device label\nvar msg1 = { payload: info.device_label || '--' };\n\n// Output 2: firmware\nvar msg2 = { payload: info.firmware_version || '--' };\n\n// Output 3: uptime\nvar msg3 = { payload: info.uptime_human || '--' };\n\n// Output 4: dev mode\nvar msg4 = { payload: info.dev_mode ? 'YES' : 'NO' };\n\n// Output 5: AC power\nvar msg5 = { payload: dc.connected ? 'Connected' : 'Disconnected' };\n\n// Output 6: battery\nvar batText = (bat.percentage !== undefined ? bat.percentage + '%' : '--');\nif (bat.voltage_mv) batText += ' (' + (bat.voltage_mv / 1000).toFixed(2) + 'V)';\nvar msg6 = { payload: batText };\n\n// Output 7: battery status\nvar msg7 = { payload: bat.status || '--' };\n\n// Output 8: storage\nvar storText = stor.used_percent !== undefined ? stor.used_percent + '% used' : '--';\nif (stor.available_bytes) storText += ' (' + (stor.available_bytes / (1024*1024*1024)).toFixed(1) + 'GB free)';\nvar msg8 = { payload: storText };\n\n// Output 9: wifi\nvar wifiText = wifi.connected ? 'Connected' : 'Disconnected';\nif (wifi.ip) wifiText += ' — ' + wifi.ip;\nif (wifi.signal_dbm) wifiText += ' (' + wifi.signal_dbm + 'dBm)';\nvar msg9 = { payload: wifiText };\n\n// Output 10: ethernet\nvar ethText = eth.connected ? 'Connected' : 'Disconnected';\nif (eth.ip) ethText += ' — ' + eth.ip;\nvar msg10 = { payload: ethText };\n\n// Output 11: internet\nvar msg11 = { payload: net.has_internet ? 'Yes' : 'No' };\n\nreturn [msg1, msg2, msg3, msg4, msg5, msg6, msg7, msg8, msg9, msg10, msg11];",
        "outputs": 11,
        "timeout": "",
        "noerr": 0,
        "x": 450,
        "y": 280,
        "wires": [
            [
                "ui-txt-label"
            ],
            [
                "ui-txt-firmware"
            ],
            [
                "ui-txt-uptime"
            ],
            [
                "ui-txt-devmode"
            ],
            [
                "ui-txt-ac"
            ],
            [
                "ui-txt-battery"
            ],
            [
                "ui-txt-batstatus"
            ],
            [
                "ui-txt-storage"
            ],
            [
                "ui-txt-wifi"
            ],
            [
                "ui-txt-ethernet"
            ],
            [
                "ui-txt-internet"
            ]
        ]
    },
