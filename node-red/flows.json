    {
        "id": "func-parse-alarm",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Parse Alarm",
        "func": "var a = msg.payload;\nvar temp = (a.temperature_celsius !== null && a.temperature_celsius !== undefined) ? Number(a.temperature_celsius).toFixed(1) + '°C' : '--';\nvar line = new Date(a.timestamp || Date.now()).toLocaleTimeString() + '  ' + (a.name || 'Line ' + a.line) + '  ' + a.from_state + ' → ' + a.to_state + '  ' + temp;\n\nvar history = flow.get('alarm_history') || [];\nhistory.unshift(line);\nif (history.length > 50) history = history.slice(0, 50);\nflow.set('alarm_history', history);\n\nvar msg1 = { payload: history.join('\\n') };\nvar msg2 = null;\nif (a.to_state === 'CRITICAL') {\n    msg2 = { payload: 'CRITICAL: ' + (a.name || 'Line ' + a.line) + ' — ' + temp };\n}\nreturn [msg1, msg2];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "x": 430,
        "y": 1040,
        "wires": [
            [
                "ui-txt-alarm-log"
            ],
            [
                "ui-notification-alarm"
            ]
        ]
