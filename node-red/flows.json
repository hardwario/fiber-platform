        "name": "Log TX",
        "func": "var entry = new Date().toLocaleTimeString() + '  TX  ' + msg.topic + '\\n  ' + JSON.stringify(msg.payload);\nvar log = flow.get('mqtt_log') || [];\nlog.unshift(entry);\nif (log.length > 30) log = log.slice(0, 30);\nflow.set('mqtt_log', log);\nvar msg1 = { payload: log.join('\\n\\n') };\nvar msg2 = { topic: msg.topic, payload: msg.payload, qos: 1 };\nreturn [msg1, msg2];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
