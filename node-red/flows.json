    {
        "id": "func-parse-sensors",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Parse Sensors",
        "func": "var sensors = msg.payload.sensors || [];\nvar timestamp = msg.payload.timestamp;\nflow.set('latest_sensors', msg.payload);\n\n// 8 sensor outputs + chart + stats + alarm status = 11 outputs\nvar outputs = [null,null,null,null,null,null,null,null,null,null,null];\nvar chartPoints = [];\nvar statsRows = [];\nvar alarmRows = [];\n\nsensors.forEach(function(s) {\n    var temp = s.temperature ? s.temperature.avg_celsius : null;\n    var state = s.dominant_alarm_state || 'DISCONNECTED';\n    if (temp === null) state = 'NO DATA';\n\n    // Per-sensor text: \"24.3°C  NORMAL\" or \"--  NO DATA\"\n    if (s.line < 8) {\n        outputs[s.line] = {\n            payload: temp !== null ? Number(temp).toFixed(1) : null,\n            title: s.name + ' (' + state + ')'\n        };\n    }\n\n    // Chart points\n    if (temp !== null) {\n        chartPoints.push({ series: s.name, x: new Date(timestamp).getTime(), y: temp });\n    }\n\n    // Stats text\n    if (s.temperature) {\n        statsRows.push(\n            s.name + ': ' +\n            Number(s.temperature.min_celsius).toFixed(1) + ' / ' +\n            Number(s.temperature.avg_celsius).toFixed(1) + ' / ' +\n            Number(s.temperature.max_celsius).toFixed(1) +\n            '  [' + state + '] (' + s.sample_count + ' samples)'\n        );\n    }\n\n    // Alarm status\n    alarmRows.push(s.name + ': ' + state + (temp !== null ? ' — ' + Number(temp).toFixed(1) + '°C' : ''));\n});\n\n// Output 9: chart\noutputs[8] = { payload: chartPoints };\n// Output 10: stats as simple text\noutputs[9] = { payload: statsRows.join('\\n') };\n// Output 11: alarm status as simple text\noutputs[10] = { payload: alarmRows.join('\\n') };\n\nreturn outputs;",
        "outputs": 11,
        "timeout": "",
        "noerr": 0,
        "x": 440,
        "y": 720,
        "wires": [
            [
                "ui-gauge-s0"
            ],
            [
                "ui-gauge-s1"
            ],
            [
                "ui-gauge-s2"
            ],
            [
                "ui-gauge-s3"
            ],
