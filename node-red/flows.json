    {
        "id": "func-build-threshold",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Build Threshold Cmd",
        "func": "var hostname = flow.get('device_hostname');\nif (!hostname) { node.warn('No device connected'); return null; }\nvar f = msg.payload;\nmsg.topic = 'fiber/' + hostname + '/commands/sensor/set_threshold';\nmsg.payload = {\n    command: 'config_request',\n    command_type: 'set_threshold',\n    params: {\n        line: parseInt(f.line),\n        thresholds: {\n            critical_low: parseFloat(f.critical_low),\n            warning_low: parseFloat(f.warning_low),\n            warning_high: parseFloat(f.warning_high),\n            critical_high: parseFloat(f.critical_high)\n        }\n    }\n};\nreturn msg;",
