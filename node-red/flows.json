    {
        "id": "mqtt-in-sensors",
        "type": "mqtt in",
        "z": "fiber-dashboard-tab",
        "name": "Sensor Data",
        "topic": "fiber/+/sensors/aggregated",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt-broker-1",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 720,
        "wires": [
