                "func-log-rx",
                "func-parse-error"
            ]
        ]
    },
    {
        "id": "func-log-rx",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Log RX",
        "func": "var raw = msg.payload;\nif (typeof raw === 'string') {\n    try { raw = JSON.parse(raw); } catch (e) { /* keep as string */ }\n}\nvar pretty = (typeof raw === 'object')\n    ? JSON.stringify(raw, null, 2)\n    : String(raw);\n\nvar entry = new Date().toLocaleTimeString() + '  RX  ' + msg.topic + '\\n' + pretty;\nvar log = flow.get('mqtt_log') || [];\nlog.unshift(entry);\nif (log.length > 30) log = log.slice(0, 30);\nflow.set('mqtt_log', log);\n\nmsg.payload = log.join('\\n\\n');\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "x": 420,
        "y": 1220,
        "wires": [
            [
                "ui-txt-terminal"
            ]
        ]
    },
    {
        "id": "func-parse-error",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Parse Error",
        "func": "var e = msg.payload;\nmsg.payload = 'Error: ' + (e.command || 'unknown') + ' \u2014 ' + (e.message || e.error || 'Unknown');\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "x": 430,
        "y": 1260,
        "wires": [
            [
                "ui-notification-error"
            ]
        ]
    },
    {
        "id": "ui-notification-error",
        "type": "ui-notification",
        "z": "fiber-dashboard-tab",
        "ui": "ui-base-1",
        "position": "bottom right",
        "colorDefault": false,
        "color": "#ff9800",
        "displayTime": "8",
        "showCountdown": true,
        "outputs": 1,
        "allowDismiss": true,
        "raw": false,
        "name": "Error Alert",
        "x": 570,
        "y": 1260,
        "wires": [
            []
        ]
    },
    {
        "id": "func-apply-thresholds",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Apply Sensor Thresholds",
        "func": "var topic = msg.topic || '';\nif (!topic.endsWith('/config/state')) return null;\n\nvar p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch (e) { return null; }\n}\nvar sensors = (p && p.sensors) || [];\nvar outputs = [null,null,null,null,null,null,null,null];\n\nsensors.forEach(function(s) {\n    if (typeof s.line !== 'number' || s.line < 0 || s.line > 7) return;\n    var t = s.thresholds || {};\n    var cl = (t.critical_low_celsius !== undefined) ? t.critical_low_celsius : 18;\n    var wh = (t.warning_high_celsius !== undefined) ? t.warning_high_celsius : 38.5;\n    var ch = (t.critical_high_celsius !== undefined) ? t.critical_high_celsius : 41;\n    var pts = [cl, wh, ch].sort(function(a,b){ return a-b; });\n    var segments = [\n        { from: -50,    color: '#2196f3' },\n        { from: pts[0], color: '#4caf50' },\n        { from: pts[1], color: '#ff9800' },\n        { from: pts[2], color: '#f44336' }\n    ];\n    outputs[s.line] = { ui_update: { segments: segments } };\n});\n\nreturn outputs;\n",
        "outputs": 8,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 700,
        "wires": [
            [
                "ui-gauge-s0"
            ],
            [
                "ui-gauge-s1"
            ],
            [
                "ui-gauge-s2"
            ],
            [
                "ui-gauge-s3"
            ],
            [
                "ui-gauge-s4"
            ],
            [
                "ui-gauge-s5"
            ],
            [
                "ui-gauge-s6"
            ],
            [
                "ui-gauge-s7"
            ]
        ]
    },
    {
        "id": "func-build-setting",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Build Setting Cmd",
        "func": "var cmd = (msg.topic || '').split('/').pop();\nif (!cmd) return null;\n\nvar paramKey = cmd === 'set_buzzer_volume' ? 'volume' : 'brightness';\nvar p = { command: cmd };\np[paramKey] = Number(msg.payload);\nmsg.payload = p;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 1620,
        "wires": [
            [
                "func-build-cmd"
            ]
        ]
    },
