    {
        "id": "func-store-cfg",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Store Cfg",
        "func": "var key = msg.topic;\nif (!key) return null;\nflow.set('cfg_' + key, msg.payload);\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 2200,
        "wires": [
            []
        ]
    },
    {
        "id": "func-build-label",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Build Label Cmd",
        "func": "var label = flow.get('cfg_device_label');\nif (label === undefined || label === '') {\n    node.warn('Device label vazio');\n    return null;\n}\nmsg.topic = 'commands/system/set_device_label';\nmsg.payload = { command: 'set_device_label', label: String(label) };\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 2290,
        "wires": [
            [
                "func-build-cmd"
            ]
        ]
    },
    {
        "id": "func-build-sensor-name",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Build Sensor Name Cmd",
        "func": "var sensor = flow.get('cfg_sensor');\nvar name = flow.get('cfg_sensor_name');\nif (sensor === undefined || name === undefined || name === '') {\n    node.warn('Sensor ou Name vazio');\n    return null;\n}\nmsg.topic = 'commands/sensor/set_sensor_name';\nmsg.payload = {\n    command: 'set_sensor_name',\n    line: parseInt(sensor) - 1,\n    name: String(name)\n};\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 2240,
        "wires": [
            [
                "func-build-cmd"
            ]
        ]
    },
    {
        "id": "func-build-sensor-location",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Build Sensor Location Cmd",
        "func": "var sensor = flow.get('cfg_sensor');\nvar location = flow.get('cfg_sensor_location');\nif (sensor === undefined || location === undefined || location === '') {\n    node.warn('Sensor ou Location vazio');\n    return null;\n}\nmsg.topic = 'commands/sensor/set_sensor_location';\nmsg.payload = {\n    command: 'set_sensor_location',\n    line: parseInt(sensor) - 1,\n    location: String(location)\n};\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 2290,
        "wires": [
            [
                "func-build-cmd"
            ]
        ]
    },
    {
        "id": "func-build-intervals",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Build Intervals Cmd",
        "func": "var sample = flow.get('cfg_sample_s');\nvar aggreg = flow.get('cfg_aggregation_s');\nvar report = flow.get('cfg_report_s');\nif (sample === undefined || aggreg === undefined || report === undefined) {\n    node.warn('Preencha os 3 intervalos');\n    return null;\n}\nmsg.topic = 'commands/system/set_interval';\nmsg.payload = {\n    command: 'set_interval',\n    sample_interval_ms:      Math.round(Number(sample) * 1000),\n    aggregation_interval_ms: Math.round(Number(aggreg) * 1000),\n    report_interval_ms:      Math.round(Number(report) * 1000)\n};\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 2340,
        "wires": [
            [
                "func-build-cmd"
            ]
        ]
    },
