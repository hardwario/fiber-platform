    {
        "id": "mqtt-in-sensors",
        "type": "mqtt in",
        "z": "fiber-dashboard-tab",
        "name": "Sensor Data",
        "topic": "fiber/+/sensors/aggregated",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt-broker-1",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 720,
        "wires": [
            [
                "func-parse-sensors"
            ]
        ]
    },
    {
        "id": "func-parse-sensors",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Parse Sensors",
        "func": "var p = msg.payload;\nvar sensors = p.sensors || [];\nvar periodEndTs = p.period_end_ts;  // unix seconds \u2014 unique per aggregation period\nvar x = periodEndTs ? periodEndTs * 1000 : Date.now();\n\nflow.set('latest_sensors', p);\n\nvar outputs = [null,null,null,null,null,null,null,null,null,null,null];\nvar chartPoints = [];\nvar statsCards = [];\nvar alarmCards = [];\n\nsensors.forEach(function(s) {\n    var temp = s.temperature ? s.temperature.avg_celsius : null;\n    var state = s.dominant_alarm_state || 'DISCONNECTED';\n    if (temp === null) state = 'NO DATA';\n\n    if (s.line < 8) {\n        outputs[s.line] = {\n            payload: temp !== null ? Number(Number(temp).toFixed(1)) : null,\n            title: s.name + ' (' + state + ')'\n        };\n    }\n\n    if (temp !== null) {\n        chartPoints.push({ series: s.name, x: x, y: temp });\n    }\n\n    statsCards.push({\n        line: s.line,\n        name: s.name,\n        state: state,\n        min: s.temperature ? Number(s.temperature.min_celsius).toFixed(1) : null,\n        avg: s.temperature ? Number(s.temperature.avg_celsius).toFixed(1) : null,\n        max: s.temperature ? Number(s.temperature.max_celsius).toFixed(1) : null,\n        samples: s.sample_count || 0\n    });\n\n    alarmCards.push({\n        line: s.line,\n        name: s.name,\n        state: state,\n        temp: temp !== null ? Number(temp).toFixed(1) : null\n    });\n});\n\nstatsCards.sort(function(a,b){ return a.line - b.line; });\nalarmCards.sort(function(a,b){ return a.line - b.line; });\n\noutputs[8]  = { payload: chartPoints };\noutputs[9]  = { payload: statsCards };\noutputs[10] = { payload: alarmCards };\n\nreturn outputs;\n",
        "outputs": 11,
        "timeout": "",
        "noerr": 0,
        "x": 440,
        "y": 720,
        "wires": [
            [
                "ui-gauge-s0"
            ],
            [
                "ui-gauge-s1"
            ],
            [
                "ui-gauge-s2"
            ],
            [
                "ui-gauge-s3"
            ],
            [
                "ui-gauge-s4"
            ],
            [
                "ui-gauge-s5"
            ],
            [
                "ui-gauge-s6"
            ],
            [
                "ui-gauge-s7"
            ],
            [
                "func-chart-format"
            ],
            [
                "ui-txt-stats"
            ],
            [
                "ui-txt-alarm-status"
            ]
        ]
    },
