    {
        "id": "mqtt-in-alarms",
        "type": "mqtt in",
        "z": "fiber-dashboard-tab",
        "name": "Alarm Events",
        "topic": "fiber/+/alarms/events",
        "qos": "2",
        "datatype": "json",
        "broker": "mqtt-broker-1",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 1040,
        "wires": [
            [
                "func-parse-alarm"
            ]
        ]
    },
    {
        "id": "func-parse-alarm",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Parse Alarm",
        "func": "var a = msg.payload;\nvar temp = (a.temperature_celsius !== null && a.temperature_celsius !== undefined) ? Number(a.temperature_celsius).toFixed(1) + '\u00b0C' : '--';\nvar line = new Date(a.timestamp || Date.now()).toLocaleTimeString() + '  ' + (a.name || 'Line ' + a.line) + '  ' + a.from_state + ' \u2192 ' + a.to_state + '  ' + temp;\n\nvar history = flow.get('alarm_history') || [];\nhistory.unshift(line);\nif (history.length > 50) history = history.slice(0, 50);\nflow.set('alarm_history', history);\n\nvar msg1 = { payload: history.join('\\n') };\nvar msg2 = null;\nif (a.to_state === 'CRITICAL') {\n    msg2 = { payload: 'CRITICAL: ' + (a.name || 'Line ' + a.line) + ' \u2014 ' + temp };\n}\nreturn [msg1, msg2];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "x": 430,
        "y": 1040,
        "wires": [
            [
                "ui-txt-alarm-log"
            ],
            [
                "ui-notification-alarm"
            ]
        ]
    },
    {
        "id": "ui-notification-alarm",
        "type": "ui-notification",
        "z": "fiber-dashboard-tab",
        "ui": "ui-base-1",
        "position": "top right",
        "colorDefault": true,
        "color": "#f44336",
        "displayTime": "10",
        "showCountdown": true,
        "outputs": 1,
        "allowDismiss": true,
        "raw": false,
        "name": "Critical Alert",
        "x": 750,
        "y": 1060,
        "wires": [
            []
        ]
    },
    {
        "id": "func-build-threshold",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Build Threshold Cmd",
        "func": "var hostname = flow.get('device_hostname');\nif (!hostname) { node.warn('No device connected'); return null; }\n\nvar sensor = flow.get('thresh_sensor');\nvar cl = flow.get('thresh_critical_low');\nvar wl = flow.get('thresh_warning_low');\nvar wh = flow.get('thresh_warning_high');\nvar ch = flow.get('thresh_critical_high');\n\nif (sensor === undefined || cl === undefined || wl === undefined || wh === undefined || ch === undefined) {\n    node.warn('Missing threshold values \u2014 move sliders first');\n    return null;\n}\n\nmsg.topic = 'fiber/' + hostname + '/commands/sensor/set_threshold';\nmsg.payload = {\n    command: 'config_request',\n    command_type: 'set_threshold',\n    params: {\n        line: parseInt(sensor) - 1,\n        thresholds: {\n            critical_low:  parseFloat(cl),\n            warning_low:   parseFloat(wl),\n            warning_high:  parseFloat(wh),\n            critical_high: parseFloat(ch)\n        }\n    }\n};\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "x": 460,
        "y": 1460,
        "wires": [
            [
                "func-log-tx"
            ]
        ]
    },
