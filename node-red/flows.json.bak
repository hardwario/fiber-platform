[
    {
        "id": "fiber-dashboard-tab",
        "type": "tab",
        "label": "FIBER Dashboard",
        "disabled": false,
        "info": "FIBER Dev Platform dashboard"
    },
    {
        "id": "mqtt-broker-1",
        "type": "mqtt-broker",
        "name": "FIBER MQTT",
        "broker": "localhost",
        "port": "1883",
        "tls": "",
        "clientid": "nodered-dashboard",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": 4,
        "keepalive": "30",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "userProps": "",
        "sessionExpiry": ""
    },
    {
        "id": "ui-base-1",
        "type": "ui-base",
        "name": "FIBER Dev Platform",
        "path": "/dashboard",
        "appIcon": ""
    },
    {
        "id": "theme-1",
        "type": "ui-theme",
        "name": "FIBER Theme",
        "colors": {
            "surface": "#1a1a2e",
            "primary": "#0f3460",
            "bgPage": "#16213e",
            "groupBg": "#1a1a2e",
            "groupOutline": "#0f3460"
        },
        "sizes": {
            "pagePadding": "12px",
            "groupGap": "12px",
            "groupBorderRadius": "8px",
            "widgetGap": "6px"
        }
    },
    {
        "id": "page-overview",
        "type": "ui-page",
        "name": "Overview",
        "ui": "ui-base-1",
        "path": "/overview",
        "icon": "mdi-view-dashboard",
        "layout": "grid",
        "theme": "theme-1",
        "order": 1
    },
    {
        "id": "page-charts",
        "type": "ui-page",
        "name": "Charts",
        "ui": "ui-base-1",
        "path": "/charts",
        "icon": "mdi-chart-line",
        "layout": "grid",
        "theme": "theme-1",
        "order": 2
    },
    {
        "id": "page-alarms",
