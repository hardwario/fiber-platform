    {
        "id": "func-build-cmd",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Build Command",
        "func": "var hostname = flow.get('device_hostname');\nif (!hostname) { node.warn('No device connected'); return null; }\nvar cmd = msg.payload.command;\nvar direct = ['get_sensor_config', 'get_interval', 'silence_buzzer'];\nmsg.topic = 'fiber/' + hostname + '/' + msg.topic;\nif (!direct.includes(cmd)) {\n    msg.payload = {\n        command: 'config_request',\n        command_type: cmd,\n        params: msg.payload,\n        reason: msg.payload.reason || undefined\n    };\n}\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "x": 440,
        "y": 1540,
        "wires": [
            [
                "func-log-tx"
            ]
        ]
    },
    {
        "id": "func-log-tx",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Log TX",
        "func": "var pretty = (typeof msg.payload === 'object')\n    ? JSON.stringify(msg.payload, null, 2)\n    : String(msg.payload);\n\nvar entry = new Date().toLocaleTimeString() + '  TX  ' + msg.topic + '\\n' + pretty;\nvar log = flow.get('mqtt_log') || [];\nlog.unshift(entry);\nif (log.length > 30) log = log.slice(0, 30);\nflow.set('mqtt_log', log);\n\nvar msg1 = { payload: log.join('\\n\\n') };\nvar msg2 = { topic: msg.topic, payload: msg.payload, qos: 1 };\nreturn [msg1, msg2];\n",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "x": 680,
        "y": 1460,
        "wires": [
            [
                "ui-txt-terminal"
            ],
            [
                "mqtt-out-cmd"
            ]
        ]
    },
