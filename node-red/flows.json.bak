    {
        "id": "func-apply-settings",
        "type": "function",
        "z": "fiber-dashboard-tab",
        "name": "Apply Settings to Sliders",
        "func": "var topic = msg.topic || '';\nif (!topic.endsWith('/config/state')) return null;\n\nvar p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch (e) { return null; }\n}\nif (!p) return null;\n\nvar screen = (p.screen_brightness !== undefined) ? Number(p.screen_brightness) : null;\nvar led    = (p.led_brightness    !== undefined) ? Number(p.led_brightness)    : null;\nvar buzz   = (p.buzzer_volume     !== undefined) ? Number(p.buzzer_volume)     : null;\n\nreturn [\n    screen !== null ? { payload: screen } : null,\n    led    !== null ? { payload: led }    : null,\n    buzz   !== null ? { payload: buzz }   : null\n];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 1500,
        "wires": [
            [
                "ui-slider-screen"
            ],
            [
                "ui-slider-led"
            ],
            [
                "ui-slider-buzzer"
            ]
        ]
    },
    {
        "id": "func-store-threshold",
