        "z": "fiber-dashboard-tab",
        "group": "group-alarm-log",
        "name": "Alarm Log",
        "order": 1,
        "width": "12",
        "height": "10",
        "head": "",
        "format": "<pre style=\"\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n    font-size: 12px;\n    line-height: 1.5;\n    color: #d4d4d4;\n    background: #0f1419;\n    padding: 12px;\n    margin: 0;\n    border-radius: 4px;\n    white-space: pre-wrap;\n    word-break: break-word;\n    overflow-y: auto;\n    height: 360px;\n    box-sizing: border-box;\n\">{{ msg.payload || '(no alarm events yet)' }}</pre>\n",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1100,
        "y": 900,
        "wires": [
            []
        ]
    },
    {
        "id": "ui-txt-alarm-status",
        "type": "ui-template",
        "z": "fiber-dashboard-tab",
        "group": "group-alarm-status",
        "name": "Alarm Status",
        "order": 1,
        "width": "12",
        "height": "6",
        "head": "",
        "format": "<div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:8px;\">\n  <div v-for=\"s in msg.payload\" :key=\"s.line\"\n       :style=\"{\n         background: stateBg(s.state),\n         border: '1px solid ' + stateBorder(s.state),\n         borderRadius: '6px',\n         padding: '12px',\n         color: '#fff',\n         display: 'flex',\n         flexDirection: 'column',\n         gap: '4px'\n       }\">\n    <div style=\"font-weight:600;font-size:13px;opacity:0.85\">{{ s.name }}</div>\n    <div :style=\"{fontSize:'24px',fontWeight:700}\">{{ s.temp ? s.temp + '\u00b0C' : '\u2014' }}</div>\n    <div :style=\"{fontSize:'11px',letterSpacing:'0.05em',fontWeight:600,color:stateColor(s.state)}\">{{ s.state }}</div>\n  </div>\n</div>\n\n<script>\n  export default {\n    methods: {\n      stateBg(state) {\n        switch (state) {\n          case 'CRITICAL':     return 'rgba(244, 67, 54, 0.18)';\n          case 'WARNING':      return 'rgba(255, 152, 0, 0.18)';\n          case 'NORMAL':       return 'rgba(76, 175, 80, 0.18)';\n          case 'DISCONNECTED':\n          case 'NO DATA':      return 'rgba(120, 120, 120, 0.18)';\n          default:             return 'rgba(33, 150, 243, 0.18)';\n        }\n      },\n      stateBorder(state) {\n        switch (state) {\n          case 'CRITICAL':     return '#f44336';\n          case 'WARNING':      return '#ff9800';\n          case 'NORMAL':       return '#4caf50';\n          case 'DISCONNECTED':\n          case 'NO DATA':      return '#666';\n          default:             return '#2196f3';\n        }\n      },\n      stateColor(state) {\n        switch (state) {\n          case 'CRITICAL':     return '#ff8a80';\n          case 'WARNING':      return '#ffb74d';\n          case 'NORMAL':       return '#a5d6a7';\n          case 'DISCONNECTED':\n          case 'NO DATA':      return '#bdbdbd';\n          default:             return '#90caf9';\n        }\n      }\n    }\n  }\n</script>\n",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1100,
        "y": 960,
        "wires": [
            []
        ]
    },
    {
        "id": "ui-txt-stats",
        "type": "ui-template",
        "z": "fiber-dashboard-tab",
        "group": "group-stats",
        "name": "Statistics",
        "order": 1,
        "width": "12",
        "height": "6",
        "head": "",
        "format": "<div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:8px;\">\n  <div v-for=\"s in msg.payload\" :key=\"s.line\"\n       :style=\"{\n         background: stateBg(s.state),\n         border: '1px solid ' + stateBorder(s.state),\n         borderRadius: '6px',\n         padding: '10px 12px',\n         color: '#fff',\n         display: 'flex',\n         flexDirection: 'column',\n         gap: '6px'\n       }\">\n    <div style=\"display:flex;justify-content:space-between;align-items:baseline;\">\n      <span style=\"font-weight:600;font-size:13px;opacity:0.85\">{{ s.name }}</span>\n      <span :style=\"{fontSize:'10px',letterSpacing:'0.05em',fontWeight:600,color:stateColor(s.state)}\">{{ s.state }}</span>\n    </div>\n    <div v-if=\"s.avg !== null\" style=\"display:flex;justify-content:space-between;font-size:12px;font-family:ui-monospace,Menlo,Consolas,monospace;\">\n      <span style=\"opacity:0.65\">min</span><span style=\"font-weight:600\">{{ s.min }}\u00b0</span>\n      <span style=\"opacity:0.65\">avg</span><span style=\"font-weight:600\">{{ s.avg }}\u00b0</span>\n      <span style=\"opacity:0.65\">max</span><span style=\"font-weight:600\">{{ s.max }}\u00b0</span>\n    </div>\n    <div v-else style=\"font-size:12px;opacity:0.55;font-style:italic\">no samples</div>\n    <div style=\"font-size:10px;opacity:0.55\">{{ s.samples }} samples</div>\n  </div>\n</div>\n\n<script>\n  export default {\n    methods: {\n      stateBg(state) {\n        switch (state) {\n          case 'CRITICAL':     return 'rgba(244, 67, 54, 0.18)';\n          case 'WARNING':      return 'rgba(255, 152, 0, 0.18)';\n          case 'NORMAL':       return 'rgba(76, 175, 80, 0.18)';\n          case 'DISCONNECTED':\n          case 'NO DATA':      return 'rgba(120, 120, 120, 0.18)';\n          default:             return 'rgba(33, 150, 243, 0.18)';\n        }\n      },\n      stateBorder(state) {\n        switch (state) {\n          case 'CRITICAL':     return '#f44336';\n          case 'WARNING':      return '#ff9800';\n          case 'NORMAL':       return '#4caf50';\n          case 'DISCONNECTED':\n          case 'NO DATA':      return '#666';\n          default:             return '#2196f3';\n        }\n      },\n      stateColor(state) {\n        switch (state) {\n          case 'CRITICAL':     return '#ff8a80';\n          case 'WARNING':      return '#ffb74d';\n          case 'NORMAL':       return '#a5d6a7';\n          case 'DISCONNECTED':\n          case 'NO DATA':      return '#bdbdbd';\n          default:             return '#90caf9';\n        }\n      }\n    }\n  }\n</script>\n",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1100,
        "y": 700,
        "wires": [
            []
        ]
    }
]