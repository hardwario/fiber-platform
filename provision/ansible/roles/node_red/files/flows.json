        }
    },
    {
        "id": "fiber-ui-page",
        "type": "ui-page",
        "name": "Thermometers",
        "ui": "fiber-ui",
        "path": "/thermometers",
        "icon": "thermometer",
        "layout": "grid",
        "theme": "fiber-ui-theme",
        "breakpoints": [
