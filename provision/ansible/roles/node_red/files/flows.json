                "px": 1024,
                "cols": 12
            }
        ],
        "order": 1,
        "className": "",
        "visible": "true",
        "disabled": "false"
    },
    {
        "id": "fiber-ui-group",
        "type": "ui-group",
        "name": "The probes on the ports",
        "page": "fiber-ui-page",
        "width": "6",
        "height": "1",
        "order": 1,
        "showTitle": true,
        "className": "",
        "visible": "true",
        "disabled": "false",
        "groupType": "default"
    },
    {
        "id": "fiber-thermometers-table",
        "type": "function",
        "z": "fiber-tab",
        "name": "The probes as a table",
        "func": "// Every probe that has a topic, one row each, by port. An empty message means the\n// probe is gone (docs/mqtt-api.md).\nconst probes = context.get(\"probes\") || {};\nconst id = msg.topic.split(\"/\").pop();\nconst t = msg.payload;\nif (!t || typeof t !== \"object\") {\n    delete probes[id];\n} else {\n    probes[id] = {\n        Port: t.port,\n        Thermometer: id,\n        \"°C\": t.temperature === null ? \"no reading\" : t.temperature.toFixed(2),\n    };\n}\ncontext.set(\"probes\", probes);\nmsg.payload = Object.values(probes).sort((a, b) => a.Port - b.Port || a.Thermometer.localeCompare(b.Thermometer));\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 220,
        "wires": [
            [
                "fiber-thermometers-ui"
            ]
        ]
    },
    {
        "id": "fiber-thermometers-ui",
        "type": "ui-table",
        "z": "fiber-tab",
        "group": "fiber-ui-group",
        "name": "Thermometers",
        "label": "",
        "order": 1,
        "width": 0,
        "height": 0,
        "maxrows": 0,
        "passthru": false,
        "autocols": true,
        "showSearch": false,
        "deselect": true,
        "selectionType": "none",
        "columns": [],
        "mobileBreakpoint": "sm",
        "mobileBreakpointType": "defaults",
        "action": "replace",
        "className": "",
        "x": 620,
        "y": 220,
        "wires": [
            []
        ]
    }
]
