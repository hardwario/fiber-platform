# A container like Raspberry Pi OS, as far as the installer is concerned: Debian trixie arm64 with
# what the Raspberry Pi OS image has and the slim Debian image lacks (curl, Python, the CA
# certificates), and the file that marks Raspberry Pi OS. Used by `just check-install`.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 \
    && rm -rf /var/lib/apt/lists/* \
    && echo "Raspberry Pi reference (a test container of the FIBER platform)" > /etc/rpi-issue
